db

# Dev scripts & docs — build-time скрипты должны остаться
scripts
!scripts/validate-env.ts
!scripts/copy-standalone-assets.js
!scripts/patch-postgres-client.js
!scripts/trace-runtime-deps.cjs
# Нужен не рантайму, а проверке типов на сборке: src/test/module-boundaries.test.ts
# импортирует отсюда два предиката. Без него `npm run build` в образе падает с
# TS2307, хотя локально собирается — локально папка scripts/ на месте.
!scripts/lib
!scripts/lib/module-boundaries.ts
docs
examples
README*
LICENSE
*.md

# Logs
*.log
lerna-debug.log*
pnpm-debug.log*

# PITR data — these live alongside the repo on the VPS but must not
# enter the build context. wal-archive/ is mode 700 owned by uid 70,
# so the docker daemon (running as user1) can't even read it — the
# build fails with "permission denied" without this entry.
wal-archive
basebackups

# Локальные папки инструментов и проверок — в образ не нужны. output/ держит
# ссылку-junction на node_modules (qa-full-20260909/app/node_modules): без этой
# строки контекст сборки 25.09.2026 разросся за 6 ГБ и выкладка встала.
output
backups
backups-local
.claude
.gitnexus
.mimocode
.tmp
.tmp-check
.worktrees
.codex
.agents
.opencode
.openclaw
