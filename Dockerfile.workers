# ============================================================
# Dockerfile — Worker Service (Outbox + Projections + PDF)
# ============================================================
# Runs background workers as a separate process from the Next.js app.
# Provides:
# - Failure isolation (workers don't affect API availability)
# - Independent scaling (scale workers without scaling API)
# - Resource limits (CPU/memory per worker group)
# - Health check endpoint (port 3002)
#
# ПОЧЕМУ БЕЗ СБОРКИ NEXT (23.09.2026). Воркеры запускаются из исходников через
# tsx; ни сборка сайта, ни пакеты next/@next/sharp им не нужны — граф импортов
# unified-worker (143 файла) не содержит ни одного обращения к ним. Прежний
# образ весил 2.46 ГБ против 0.76 ГБ у app: полная сборка Next (157 МБ),
# неиспользуемый next с бинарниками (~430 МБ) и слой `npm install tsx`
# (438 МБ), который доустанавливал dev-зависимости поверх очищенного дерева.
# На 30-гигабайтном VPS сборка такого образа доводила диск до 100%.
# ============================================================

# ============================================================
# Stage 1: Dependencies (full — prisma CLI нужен для generate)
# ============================================================
FROM node:22-alpine AS deps
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit --ignore-scripts

# ============================================================
# Stage 2: Prisma client + production-only node_modules
# ============================================================
FROM node:22-alpine AS builder
WORKDIR /app

ENV DATABASE_URL_POSTGRES=postgresql://build:build@localhost:5432/build

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY scripts/patch-postgres-client.js ./scripts/
COPY src ./src

# Клиент генерируется в src/generated — вместе с исходниками он и уедет.
# db:generate = prisma generate + патч клиента: прежний образ получал патч
# через `npm run build`, и в бою воркеры работали именно с таким клиентом.
RUN npm run db:generate

# tsx — production-зависимость (package.json), поэтому переживает prune.
# next/@next/sharp остаются в дереве как зависимости сайта, но воркерам не
# нужны: удаляем, а не держим ~430 МБ ради ничего.
RUN npm prune --omit=dev && \
    rm -rf node_modules/next node_modules/@next node_modules/@img node_modules/sharp

# ============================================================
# Stage 3: Worker Runner
# ============================================================
FROM node:22-alpine AS runner
WORKDIR /app

# Install dependencies for health checks and Prisma
RUN apk add --no-cache curl tini openssl

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# --chown sets ownership inline; a separate `RUN chown -R /app` would rewrite
# every file's metadata into a duplicate overlay layer, doubling the image.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/src ./src
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/package.json /app/tsconfig.json ./
# PDF-генератор читает шрифты из public/fonts (lib/pdf-generator/fonts.ts);
# остальное из public — картинки сайта, воркерам не нужны.
COPY --chown=nextjs:nodejs public/fonts ./public/fonts

# Own the /app dir itself (its contents are already nextjs-owned via COPY --chown).
# Without this, the local-fallback PDF path (savePdfBuffer → cwd/storage when S3
# is off) can't mkdir under /app. One dir = negligible layer, unlike `chown -R`.
RUN chown nextjs:nodejs /app

# Use tini as init system (proper signal handling)
ENTRYPOINT ["/sbin/tini", "--"]

USER nextjs

ENV NODE_ENV=production
ENV WORKER_HEALTH_PORT=3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3002/health || exit 1

EXPOSE 3002

# Start all workers (can override via ENABLED_WORKERS env var)
CMD ["npx", "tsx", "src/workers/unified-worker.ts"]
