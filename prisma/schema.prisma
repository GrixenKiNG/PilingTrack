model AuditLog {
  id        String   @id @default(cuid())
  entity    String // e.g. "Report", "User", "Site"
  action    String // e.g. "created", "updated", "deleted", "submitted"
  entityId  String // ID of the affected entity
  before    Json? // Previous state (null for create)
  after     Json? // New state (null for delete)
  userId    String? // Actor
  userName  String? // Denormalized for fast reads
  userRole  String? // Denormalized
  tenantId  String? // Multi-tenant isolation
  requestId String? // Correlation ID
  ipAddress String? // Client IP
  userAgent String? // Client info
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  // ADR-0043 v1 chain fields. They remain nullable while unmapped legacy rows
  // are quarantined/backfilled; native readiness events populate every field.
  sequence           BigInt?
  occurredAt         DateTime? @db.Timestamptz(3)
  recordedAt         DateTime? @db.Timestamptz(3)
  actorId            String?
  actingAs           String?
  entityType         String?
  entityVersion      Int?
  correlationId      String?
  idempotencyKeyHash Bytes?    @db.ByteA
  metadata           Json?
  prevHash           Bytes?    @db.ByteA
  hash               Bytes?    @db.ByteA

  // Immutable guarantee: no UPDATE, only INSERT
  // Soft-delete protection via application layer

  @@unique([tenantId, sequence])
  @@unique([tenantId, hash])
  @@index([entity, entityId])
  @@index([userId, timestamp])
  @@index([tenantId, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
  @@index([tenantId, occurredAt, id])
  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@index([tenantId, action, occurredAt])
}

model TenantAuditChain {
  tenantId     String   @id
  lastSequence BigInt   @default(0)
  headHash     Bytes?   @db.ByteA
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// ============================================================
// IDEMPOTENCY KEYS — Prevent duplicate API requests
// ============================================================

model IdempotencyKey {
  id              String    @id @default(cuid())
  key             String // Client-provided unique key
  scope           String // API endpoint / operation scope
  status          String    @default("processing") // processing | completed | failed
  result          Json? // Cached response
  error           String? // Error message if failed
  statusCode      Int? // HTTP status code for errors
  expiresAt       DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)
  // Readiness command-pipeline fields. Nullable for existing callers until a
  // deterministic tenant/request-hash backfill can be approved.
  tenantId        String?
  actorId         String?
  requestHash     Bytes?    @db.ByteA
  responseHeaders Json?

  @@unique([scope, key])
  @@unique([tenantId, scope, key])
  @@index([scope, key])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@index([tenantId, actorId, createdAt])
}

// ============================================================
// DEVICE SYNC STATE — Per-device sync tracking
// ============================================================

model DeviceSyncState {
  id              String   @id @default(cuid())
  deviceId        String   @unique
  tenantId        String?
  userId          String?
  lastSyncAt      DateTime @default(now()) @db.Timestamptz(3)
  syncStatus      String   @default("idle") // idle, syncing, failed
  lastError       String?
  changesSent     Int      @default(0)
  changesRecv     Int      @default(0)
  lastVectorClock Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@index([syncStatus])
  @@index([lastSyncAt])
}

model TrustedOperatorDeviceRecord {
  id String @id
  tenantId String
  operatorId String
  keyId String
  publicKeyPem String @db.Text
  state String @default("ACTIVE")
  registeredAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  lastAcceptedSequence Int @default(0)
  @@index([tenantId,operatorId,state])
}

model ServerOfflineAuthorizationKey {
  keyId String @id
  algorithm String
  publicKeyPem String @db.Text
  state String @default("ACTIVE")
  tenantId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model OfflineWorkAuthorizationRecord {
  id String @id
  tenantId String
  operatorId String
  deviceId String
  shiftId String
  equipmentId String
  authorization Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([tenantId,operatorId,deviceId,expiresAt])
}

// ============================================================
// MEDIA — Photo/document management with S3
// ============================================================

model Media {
  id           String  @id @default(cuid())
  fileName     String
  contentType  String // image/jpeg, application/pdf, etc.
  fileSize     Int     @default(0) // bytes (0 until confirmed)
  key          String  @unique // S3 object key
  thumbnailKey String? // S3 thumbnail key
  cdnUrl       String? // Public CDN URL

  tenantId   String?
  userId     String
  entityType String? // "report", "site", "equipment"
  entityId   String?

  uploadStatus String    @default("pending") // pending, completed, failed
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime? @db.Timestamptz(3)
  deletedBy    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([uploadStatus])
  @@index([isDeleted, deletedAt])
}

// ============================================================
// CONFLICT AUDIT — Immutable conflict resolution log
// ============================================================

model ConflictAudit {
  id                 String   @id @default(cuid())
  entityId           String // Report ID or other entity
  entityType         String // "report", "pile_work", etc.
  conflictType       String // "version", "concurrent", "semantic"
  resolutionStrategy String // "lww", "server_wins", "field_merge", "vector_clock_merge"
  fieldsInConflict   Json // ["status", "shiftStart", "piles", ...]
  resolutionDetails  Json // Full field-level resolution details
  deviceId           String // Client device that caused conflict
  tenantId           String?
  userId             String?
  clientVersion      Int?
  serverVersion      Int?
  clientVectorClock  Json?
  serverVectorClock  Json?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
  @@index([tenantId, createdAt])
  @@index([deviceId, createdAt])
  @@index([resolutionStrategy])
  @@index([conflictType])
}

// ============================================================
// REFRESH TOKENS — Session management with rotation
// ============================================================

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique // Hashed token
  family          String // Token family for rotation detection
  familyCreatedAt DateTime  @default(now()) @db.Timestamptz(3) // Family birth time; carried forward on rotation to cap total family lifetime (REFRESH_TOKEN_FAMILY_TTL_DAYS)
  expiresAt       DateTime  @db.Timestamptz(3)
  revoked         Boolean   @default(false)
  revokedAt       DateTime? @db.Timestamptz(3)
  revokedReason   String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt      DateTime? @db.Timestamptz(3)
  ipAddress       String?
  userAgent       String?

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([revoked, expiresAt])
}

// ============================================================
// REPORT PHOTOS — Photo evidence for compliance
// ============================================================

model ReportPhoto {
  id       String  @id @default(cuid())
  reportId String?
  siteId   String
  tenantId String?

  // Photo metadata
  fileName String
  mimeType String // image/jpeg, image/png, image/webp
  fileSize Int // bytes
  width    Int?
  height   Int?

  // Context
  latitude    Float?
  longitude   Float?
  altitude    Float?
  description String? // Optional operator note
  photoType   String  @default("work_evidence") // work_evidence, issue, site_overview

  // Storage
  storagePath   String // Local file path or S3 key
  thumbnailPath String? // Thumbnail path
  mediaId       String? // Link to Media table (optional)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String? // User ID who uploaded

  @@index([reportId])
  @@index([siteId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([photoType])
}

// ============================================================
// Dead Letter Queue — permanently failed outbox events
// ============================================================
// Events that exceed MAX_RETRIES in OutboxEvent are moved here for
// manual inspection, retry with debugging, and alerting on persistent
// failures. Separating DLQ from the hot outbox keeps the retry loop
// scanning only live rows.
model DeadLetterQueue {
  id             String   @id @default(cuid())
  eventType      String
  aggregateId    String?
  payload        Json
  errorMessage   String
  attempts       Int      @default(0)
  sourceOutboxId String?
  status         String   @default("pending") // pending | resolved | discarded
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([eventType])
  @@index([aggregateId])
}

// ============================================================
// Заявки с публичного сайта ОРИОН
// ============================================================
/// Заявка, отправленная формой на /orion.
///
/// ЗАЧЕМ ТАБЛИЦА. Раньше единственным экземпляром заявки было сообщение в
/// Telegram: отправка шла «в никуда» (`void`), ответ «принято» уходил
/// посетителю независимо от результата, а в журнал писался только признак
/// «текст есть». Недоступный Telegram — а он у этого провайдера ходит через
/// прокси — означал потерянного клиента, уверенного, что его услышали.
///
/// Строка пишется ДО отправки, поэтому заявка переживает любой сбой доставки.
model OrionLead {
  id       String @id @default(cuid())
  tenantId String

  name    String
  contact String
  message String @default("")

  /// Сработала ловушка для ботов. Такие заявки не уходят в Telegram, но
  /// сохраняются: ловушка может ошибиться (менеджер паролей заполнит скрытое
  /// поле), и тихо терять настоящего клиента дороже, чем хранить спам.
  isSpam Boolean @default(false)

  /// Когда сообщение ушло в Telegram. `null` при незакрытой доставке —
  /// это и есть список заявок, о которых компания могла не узнать.
  deliveredAt   DateTime? @db.Timestamptz(3)
  deliveryError String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([deliveredAt])
}
