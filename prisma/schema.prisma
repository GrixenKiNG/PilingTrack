  answeredBy  User                       @relation("OperatorChecklistAnswerRecordedBy", fields: [tenantId, answeredById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, clientCommandId])
  @@unique([tenantId, executionId, itemId])
  @@index([tenantId, executionId, answeredAt])
}

model OperatorShiftEvidence {
  id              String               @id @default(cuid())
  tenantId        String
  shiftId         String
  equipmentId     String
  kind            OperatorEvidenceKind
  payload         Json
  occurredAt      DateTime             @db.Timestamptz(3)
  recordedById    String
  clientCommandId String
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shift       Shift     @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  equipment   Equipment @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)
  recordedBy  User      @relation("OperatorShiftEvidenceRecordedBy", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, clientCommandId])
  @@index([tenantId, shiftId, kind, occurredAt])
  @@index([tenantId, equipmentId, kind, occurredAt])
}

/// Отдельный процесс безопасности. Это не дефект установки: событие может
/// относиться к человеку, рабочей зоне или организации работ.
model SafetyIncident {
  id                    String   @id @default(cuid())
  tenantId              String
  shiftId               String?
  equipmentId           String?
  siteId                String?
  relatedDefectId       String?
  category              String
  state                 String
  severity              String
  description           String   @db.Text
  observedSigns         Json
  stopRequired          Boolean
  emergencyStopApplied  Boolean  @default(false)
  injured               Boolean  @default(false)
  safeStateDescription  String?  @db.Text
  evidenceMediaIds      Json     @default("[]")
  classificationRuleId  String
  classificationRuleVersion String
  stoppedAt             DateTime? @db.Timestamptz(3)
  stoppedById           String?
  resumeSnapshotId      String?
  /// Разбор происшествия: кто, когда и к чему пришли. Пусто — ещё не разобрано.
  reviewedAt            DateTime? @db.Timestamptz(3)
  reviewedById          String?
  reviewNote            String?  @db.Text
  occurredAt            DateTime @db.Timestamptz(3)
  receivedAt            DateTime @default(now()) @db.Timestamptz(3)
  reportedById          String
  deviceId              String?
  clientCommandId       String
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, clientCommandId])
  @@index([tenantId, shiftId, state])
  @@index([tenantId, equipmentId, occurredAt])
  @@index([tenantId, relatedDefectId])
  @@index([tenantId, reviewedAt, occurredAt(sort: Desc)])
}

model RepairVerification {
  id String @id @default(cuid())
  tenantId String
  incidentId String
  shiftId String?
  equipmentId String
  repairStatus String @default("NOT_STARTED")
  repairSummary String? @db.Text
  repairedById String?
  repairedAt DateTime? @db.Timestamptz(3)
  verificationStatus String @default("NOT_REQUESTED")
  verificationRevision Int @default(0)
  verifiedById String?
  verifiedAt DateTime? @db.Timestamptz(3)
  verificationNote String? @db.Text
  evidenceMediaIds Json @default("[]")
  readinessRequestedAt DateTime? @db.Timestamptz(3)
  readinessSnapshotId String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, incidentId])
  @@unique([tenantId, id])
  @@index([tenantId, equipmentId, updatedAt])
}

/// Личный шаблон места работ: пара «место работы + объект», сохранённая
/// пользователем, чтобы не вписывать одно и то же заново.
///
/// Почему это НЕ справочник организации. Владелец сформулировал так: место и
/// объект вписывает тот, кто оформляет наряд, они меняются, и у одного человека
/// таких мест может быть много. Общий справочник заставил бы админа заранее
/// перечислить все площадки — а их никто не знает наперёд. Здесь список растёт
/// сам, по мере работы, и он личный: чужие площадки в подсказках не мешают.
///
/// В сам наряд попадает ТЕКСТ, а не ссылка на эту строку: наряд — документ, и
/// удаление шаблона не должно менять то, что было подписано.
model UserPlacePreset {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  user          User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  location      String
  objectName    String
  /// Защита от дублей: обе строки, свёрнутые к нижнему регистру. Без неё
  /// «Площадка 3» и «площадка 3» осели бы в подсказках двумя строками.
  normalizedKey String
  /// Когда шаблоном пользовались последний раз — недавние показываем первыми.
  usedAt        DateTime @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, userId, normalizedKey])
  @@index([tenantId, userId, usedAt])
}

/// Вид работ наряда-допуска. Справочник, а не enum: набор задаётся правилами
/// охраны труда заказчика и пополняется админом (решение владельца 16.08.2026).
/// Именно поэтому риск здесь — свойство СТРОКИ справочника: зашей правило
/// «огневые = повышенный» в код, и заведённый админом новый вид работ молча
/// считался бы обычным.
model PermitWorkType {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String // «Огневые работы»
  normalizedName String
  /// Пояснение под названием на плитке выбора: «Сварка, резка, пайка».
  hint           String         @default("")
  /// Значок плитки. Слаг, а не имя компонента: интерфейс сам решает, чем его
  /// рисовать, и переживает неизвестное значение запасным значком.
  icon           String         @default("")
  /// Категория риска, подставляемая в новый наряд. Теперь это ЯРЛЫК: сколько
  /// подписей нужно, решает requiredApprovals ниже, а не риск.
  defaultRisk    WorkPermitRisk @default(NORMAL)
  /// Какие подписи требует этот вид работ. Задаёт админ: нормативы у каждой
  /// организации свои, и решать за него разработчик не вправе. Пусто — наряд
  /// согласовывать некому, поэтому пустой список считается ошибкой настройки
  /// (см. effectiveApprovalRule).
  requiredApprovals   WorkPermitApprovalRole[] @default([DISPATCHER])
  /// Может ли автор подписать собственный наряд. Тоже решение заказчика:
  /// «второй глаз» стоит денег и времени, и где он обязателен — знает он.
  allowAuthorApproval Boolean        @default(true)
  /// Типовые опасные факторы этого вида работ: подсказки в форме наряда.
  /// Админ пополняет их прямо из наряда кнопкой «сохранить в шаблон».
  hazardPresets  String[] @default([])
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  permits WorkPermit[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive, sortOrder])
}

model WorkPermit {
  id             String               @id @default(cuid())
  tenantId       String
  equipmentId    String
  shiftId        String?
  risk           WorkPermitRisk
  state          WorkPermitState      @default(DRAFT)
  /// Вид работ. Необязателен: наряды, выписанные до появления справочника
  /// (16.08.2026), его не имеют, и переписывать боевые данные ради колонки
  /// незачем. Обязательность включена в валидации для НОВЫХ нарядов.
  workTypeId     String?
  workType       PermitWorkType?      @relation(fields: [tenantId, workTypeId], references: [tenantId, id], onDelete: Restrict)
  /// Снимок требования к подписям на момент оформления. Живьём из справочника
  /// читать нельзя: правка вида работ переписала бы прошлое — вчера подписанные
  /// наряды разом стали бы недоподписанными или, наоборот, «согласованными» без
  /// нужной подписи. Снимок обновляется при правке наряда, а она и так
  /// аннулирует подписи.
  requiredApprovals   WorkPermitApprovalRole[] @default([])
  allowAuthorApproval Boolean              @default(true)
  /// Наименование работ — короткая строка в реестре: «Сварочные работы по
  /// ремонту гидравлики». До этого в реестре показывали начало `scope`.
  title          String               @default("")
  /// Место работы и объект — свободный текст, а не ссылки. Наряд это документ:
  /// переименование или архивация объекта не должны задним числом менять то,
  /// что было подписано. Подсказки при вводе берутся из объектов системы и
  /// личных шаблонов пользователя, но в наряд попадает именно текст.
  location       String               @default("")
  objectName     String               @default("")
  /// Опасные факторы этого наряда. Заполняются из типовых факторов вида работ
  /// либо вписываются руками.
  hazards        String[] @default([])
  /// Три ответственных лица. Гибрид по решению владельца: либо учётная запись,
  /// либо просто ФИО — у наблюдающего учётки может не быть вовсе.
  /// ФИО хранится ВСЕГДА, даже когда выбран пользователь: это снимок на момент
  /// подписания, и он переживёт переименование или удаление учётки. Внешнего
  /// ключа намеренно нет — как у authorId и revokedById рядом.
  producerUserId String?
  producerName   String               @default("")
  observerUserId String?
  observerName   String               @default("")
  safetyUserId   String?
  safetyName     String               @default("")
  scope          String               @db.Text
  validFrom      DateTime             @db.Timestamptz(3)
  validTo        DateTime             @db.Timestamptz(3)
  timezone       String
  authorId       String
  lastEditedById String
  submittedAt    DateTime?            @db.Timestamptz(3)
  approvedAt     DateTime?            @db.Timestamptz(3)
  revokedAt      DateTime?            @db.Timestamptz(3)
  revokedById    String?
  revokeReason   String?
  expiredAt      DateTime?            @db.Timestamptz(3)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  approvals      WorkPermitApproval[]
  shift          Shift?               @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)
  author    User      @relation("WorkPermitAuthoredBy", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict)
  editor    User      @relation("WorkPermitEditedBy", fields: [tenantId, lastEditedById], references: [tenantId, id], onDelete: Restrict)
  revoker   User?     @relation("WorkPermitRevokedBy", fields: [tenantId, revokedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, equipmentId, state, validTo])
  @@index([tenantId, state, updatedAt])
  @@index([tenantId, risk, updatedAt])
  @@index([tenantId, shiftId])
  // Под защиту справочника: «вид работ используется, удаление недоступно».
  @@index([tenantId, workTypeId])
}

model WorkPermitApproval {
  id                 String                 @id @default(cuid())
  tenantId           String
  permitId           String
  permitVersion      Int
  role               WorkPermitApprovalRole
  approvedById       String
  approvedAt         DateTime               @default(now()) @db.Timestamptz(3)
  valid              Boolean                @default(true)
  invalidatedAt      DateTime?              @db.Timestamptz(3)
  invalidationReason String?
  permit             WorkPermit             @relation(fields: [tenantId, permitId], references: [tenantId, id], onDelete: Restrict)

  approver User @relation("WorkPermitApprovedBy", fields: [tenantId, approvedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, permitId, permitVersion, role])
  @@index([tenantId, permitId, permitVersion, valid])
  @@index([tenantId, approvedById, approvedAt])
}

model ModuleLayoutTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  surfaceId String
  // '' = base layout for the whole surface (applied to every tile without its
  // own override); a non-empty value scopes the layout to one entity (e.g. a
  // single equipment card the admin customized).
  entityId  String   @default("")
  template  Json
  updatedBy String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, surfaceId, entityId])
  @@index([tenantId])
}

model Inspection {
  id                  String             @id @default(cuid())
  tenantId            String
  equipmentId         String
  templateId          String
  maintenanceRecordId String?            @unique // 1:1 с записью ТО (ЕО/ТО)
  /// Смена, к которой относится осмотр. Необязательна: осмотры до 20.08.2026
  /// смены не знают, и ТО механика вне смены её тоже не имеет.
  shiftId             String?
  phase               InspectionPhase    @default(PRE_SHIFT)
  level               ChecklistLevel
  performedById       String
  shift               String?
  inspectionDate      DateTime           @db.Timestamptz(3)
  engineHours         Int?
  healthScore         Int?
  status              InspectionStatus   @default(DRAFT)
  templateSnapshot    Json
  signedByName        String?
  signedAt            DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  answers             InspectionAnswer[]
  equipment           Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  template            ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, equipmentId])
  @@index([tenantId, status])
  @@unique([tenantId, shiftId, phase])
}

model InspectionAnswer {
  id           String     @id @default(cuid())
  tenantId     String
  inspectionId String
  itemId       String
  result       String
  value        String?
  note         String?
  photoCount   Int        @default(0)
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inspectionId])
}

// ============================================================
// DEVICE KEYS — IoT telemetry authentication
// Plaintext key is shown to the operator exactly once at provisioning
// and never stored; only `keyHash` (HMAC-SHA256 with DEVICE_KEY_LOOKUP_SECRET)
// is persisted, so DB read access alone cannot impersonate a device.
// ============================================================
model DeviceKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique
  name        String // operator-facing label (e.g. "Rig 4 — North site MQTT")
  tenantId    String?
  equipmentId String
  siteId      String?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdById String?
  lastUsedAt  DateTime? @db.Timestamptz(3)

  // Опциональная ссылка на физическое/виртуальное устройство.
  // Для PUSH-боксов (Teltonika и пр.) один TelematicsDevice → один-два
  // активных DeviceKey (текущий + переходный при ротации).
  telematicsDeviceId String?

  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  telematicsDevice TelematicsDevice? @relation(fields: [telematicsDeviceId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([tenantId])
  @@index([revoked])
  @@index([telematicsDeviceId])
}

// ============================================================
// TELEMATICS DEVICE — точка телеметрии на машине
// ------------------------------------------------------------
// Один device = одна "точка съёма данных". Это может быть:
//   PUSH — физический бокс (Teltonika FMC640, Galileosky 7x),
//          шлёт данные нам по HTTP/MQTT; авторизация через DeviceKey.
//   PULL — виртуальный коннектор к OEM API (LiDAT, Volvo CareTrack...),
//          мы поллим их облако. Поллер появится позже; поля
//          (endpointUrl, pollIntervalSec, lastPolledAt, nextPollAt)
//          уже заведены — БД готова, миграции не понадобится.
//
// Жизненный цикл status:
//   PROVISIONED → ACTIVE → DEGRADED → OFFLINE → ARCHIVED
// ============================================================
model TelematicsDevice {
  id       String @id @default(cuid())
  tenantId String

  provider        TelematicsProvider
  model           String? // субмодель: "FMC640", "Hiper VR"
  firmwareVersion String?

  imei         String? // для cellular-боксов
  serialNumber String?
  oemAccountId String? // ID в Wialon / Volvo CareTrack и т.п.

  authType TelematicsAuthType

  // Зарезервировано для PULL-режима. Сейчас все строки = NULL.
  endpointUrl     String?
  pollIntervalSec Int?
  lastPolledAt    DateTime? @db.Timestamptz(3)
  nextPollAt      DateTime? @db.Timestamptz(3)

  equipmentId String?
  installedAt DateTime? @db.Timestamptz(3)

  status     TelematicsStatus @default(PROVISIONED)
  lastSeenAt DateTime?        @db.Timestamptz(3)
  lastError  String?

  label     String // operator-facing: "Бауман-100 (FMC640)"
  notes     String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  equipment   Equipment?                   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  tenant      Tenant                       @relation(fields: [tenantId], references: [id])
  deviceKeys  DeviceKey[]
  assignments TelematicsDeviceAssignment[]

  @@unique([provider, imei], map: "uq_telematics_provider_imei")
  @@index([tenantId])
  @@index([equipmentId])
  @@index([provider])
  @@index([status])
  @@index([nextPollAt])
}

enum TelematicsProvider {
  TELTONIKA_FMC640
  TELTONIKA_FMB640
  GALILEOSKY_7X
  WIALON_GENERIC
  OTHER
}

enum TelematicsAuthType {
  PUSH_TOKEN // device пушит к нам, авторизация через DeviceKey
  API_KEY // зарезервировано (PULL)
  OAUTH2 // зарезервировано (PULL)
  IP_ALLOWLIST // зарезервировано
  NONE
}

enum TelematicsStatus {
  PROVISIONED
  ACTIVE
  DEGRADED
  OFFLINE
  ARCHIVED
}

// ============================================================
// TELEMATICS DEVICE ASSIGNMENT — append-only история привязок
// ------------------------------------------------------------
// "Teltonika #FMC-1234 стояла на LRH 100 №1 с 2026-05-17
//  по 2026-09-15, потом перенесена на Banut 655."
// Нужен для аудита ("чьи это данные были по той свае?")
// и для замен боксов в эксплуатации.
// ============================================================
model TelematicsDeviceAssignment {
  id          String    @id @default(cuid())
  tenantId    String
  deviceId    String
  equipmentId String
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3) // NULL = текущая активная
  reason      String? // "first install", "swap to rig-7"

  device    TelematicsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  equipment Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@index([equipmentId, startedAt])
  @@index([tenantId])
}

// ============================================================
// SITES
// ============================================================

model Site {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String
  /// Координаты площадки. Нужны, чтобы тянуть скорость ветра из погодного
  /// сервиса: у Liebherr работы прекращают при 20 м/с, а стрелу переводят в
  /// транспортное положение при 36 м/с. Необязательны — объект без координат
  /// работает как прежде, оператор вписывает ветер руками.
  latitude        Float?
  longitude       Float?
  isActive        Boolean   @default(true)
  plannedPiles    Int       @default(0)
  plannedDrilling Float     @default(0)
  status          String    @default("ACTIVE")
  completionDate  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant        Tenant?              @relation(fields: [tenantId], references: [id])
  fields        PileField[]
  pilePlans     SitePilePlan[]
  drillingPlans SiteDrillingPlan[]
  users         UserSiteAssignment[]
  reports       Report[]
  crews         Crew[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([isActive])
  @@index([tenantId, isActive])
}

// Site pile plan: grade → count × meters per unit → auto total meters
model SitePilePlan {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pileGradeId   String
  pileGrade     PileGrade @relation(fields: [pileGradeId], references: [id], onDelete: Cascade)
  count         Int       @default(0)
  metersPerUnit Float     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([siteId])
  @@index([pileGradeId])
}

// Site drilling plan: diameter → count × meters per unit → auto total meters
model SiteDrillingPlan {
  id            String @id @default(cuid())
  siteId        String
  site          Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  diameter      Float  @default(0)
  count         Int    @default(0)
  metersPerUnit Float  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([siteId])
}

model PileField {
  id     String @id @default(cuid())
  name   String
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  clusters Cluster[]

  @@index([siteId])
}

model Cluster {
  id      String    @id @default(cuid())
  name    String
  fieldId String
  field   PileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  pickets Picket[]

  @@index([fieldId])
}

model Picket {
  id        String  @id @default(cuid())
  name      String
  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  piles     PileWork[]
  drillings LeaderDrilling[]

  @@index([clusterId])
}

// ============================================================
// CREWS — with named assistants
// ============================================================

model Crew {
  id          String  @id @default(cuid())
  name        String  @default("")
  isActive    Boolean @default(true)
  /// Не уникален с 20.08.2026: администратор закрепляет за оператором список
  /// установок, а оператор выбирает из него ту, на которой работает сегодня.
  /// Обратное ограничение сохраняется: установка остаётся за одной активной
  /// бригадой (`assertEquipmentNotDoubleBooked`).
  operatorId  String
  equipmentId String
  siteId      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  operator   User            @relation("CrewOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  site       Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  reports    Report[]
  assistants CrewAssistant[]

  @@index([operatorId])
  @@index([equipmentId])
  @@index([siteId])
  @@index([isActive])
}

// Named crew assistants (ФИО помощника)
model CrewAssistant {
  id     String  @id @default(cuid())
  crewId String
  crew   Crew    @relation(fields: [crewId], references: [id], onDelete: Cascade)
  // Optional link to the ASSISTANT user. `name` is kept as a point-in-time
