model Report {
  id                  String  @id @default(cuid())
  tenantId            String?
  reportId            String  @unique
  userId              String
  crewId              String?
  equipmentId         String?
  siteId              String
  date                String
  shiftType           String  @default("DAY")
  shiftStart          String?
  shiftEnd            String?
  status              String  @default("draft")
  version             Int     @default(1)
  vectorClock         Json? // Vector clock for causal ordering (new in v3)
  lastEditedById      String?
  lastEditedByName    String?
  lastEditedByRole    String?
  journalPhotoMediaId String?
  /// Смена контура готовности, в которой сделан отчёт. Необязательна:
  /// отчёты, созданные до 20.08.2026, смены не знают, и восстанавливать
  /// связь задним числом нечем. Внешнего ключа намеренно нет — как у
  /// lastEditedById рядом; смена живёт в своём модуле со своими правилами.
  shiftId             String?
  endingEngineHours   Int?
  /// Остаток топлива в процентах на конец смены. Снимается с указателя в ЕО
  /// после работы и показывается следующей смене при приёме установки: без
  /// него машинист узнаёт, что бак пуст, уже заведя двигатель. Телеметрии на
  /// установках нет, поэтому источник один — глаза оператора.
  endingFuelPercent   Int?
  closingComment      String? @db.Text
  submittedAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crew      Crew?      @relation(fields: [crewId], references: [id], onDelete: SetNull)
  equipment Equipment? @relation("ReportEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)

  downtimes ReportDowntime[]
  piles     PileWork[]
  drillings LeaderDrilling[]

  @@index([tenantId])
  @@index([tenantId, updatedAt])
  @@index([userId, date])
  @@index([siteId, date])
  @@index([status])
  @@index([crewId])
  @@index([equipmentId])
  @@index([tenantId, shiftId])
  // Кроме этого ключа в базе живёт частичный уникальный индекс
  // Report_user_site_date_without_shift_key на (userId, siteId, date) для строк
  // с shiftId IS NULL: у отчётов без смены новый ключ ничего не ограничивает,
  // потому что NULL в уникальном индексе не равен другому NULL. Prisma
  // частичные индексы не описывает — он задан миграцией и снимать его нельзя.
  @@unique([tenantId, shiftId])
}

