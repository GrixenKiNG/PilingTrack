  // (onDelete: SetNull nulls the link but preserves the row + name).
  userId String?
  user   User?   @relation("CrewAssistantUser", fields: [userId], references: [id], onDelete: SetNull)
  name   String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([crewId])
  @@index([userId])
}

