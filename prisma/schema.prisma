generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/postgres-client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANTS — Multi-tenant isolation
// ============================================================

model Tenant {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  isActive Boolean @default(true)
  maxUsers Int     @default(10)
  plan     String  @default("free")

  // Billing & Subscription
  billingEmail       String?
  stripeCustomerId   String?
  subscriptionStatus String    @default("inactive") // inactive, trial, active, past_due, canceled
  trialEndsAt        DateTime? @db.Timestamptz(3)
  subscriptionEndsAt DateTime? @db.Timestamptz(3)
  lastBillingAt      DateTime? @db.Timestamptz(3)
  monthlyFee         Decimal   @default(0) @db.Decimal(12, 2)
  currency           String    @default("RUB")

  // Usage tracking
  currentUsers  Int   @default(0)
  currentSites  Int   @default(0)
  storageUsedMB Float @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users             User[]
  sites             Site[]
  settings          TenantSettings?
  invoices          TenantInvoice[]
  telematicsDevices TelematicsDevice[]
  pileGrades        PileGrade[]
  drillingTypes     DrillingType[]
  downtimeReasons   DowntimeReason[]
  userDocumentTypes UserDocumentType[]
  permitWorkTypes   PermitWorkType[]
  auditChain        TenantAuditChain?
  operatorChecklistTemplates OperatorChecklistTemplate[]
  operatorChecklistExecutions OperatorChecklistExecution[]
  operatorChecklistAnswers OperatorChecklistAnswerRecord[]
  operatorShiftEvidence OperatorShiftEvidence[]

  shifts      Shift[]
  workPermits WorkPermit[]

  @@index([slug])
  @@index([isActive])
  @@index([subscriptionStatus])
}

// Tenant Invoices — Billing history
model TenantInvoice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceNumber   String    @unique
  periodStart     DateTime  @db.Timestamptz(3)
  periodEnd       DateTime  @db.Timestamptz(3)
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @default("RUB")
  status          String    @default("pending") // pending, paid, overdue, canceled
  paidAt          DateTime? @db.Timestamptz(3)
  stripeInvoiceId String?

  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId])
  @@index([status])
  @@index([periodStart])
}

// ============================================================
// USERS — 7 roles: ADMIN, DISPATCHER, OPERATOR, ASSISTANT, MECHANIC, FOREMAN,
// SAFETY_ENGINEER. Список держит CHECK chk_user_role_valid в базе; при
// добавлении роли правьте и его, и scripts/postgres-production-hardening.sql.
// ============================================================

model User {
  id             String  @id @default(cuid())
  tenantId       String
  email          String  @unique
  password       String  @default("")
  // Stores the bcrypt(PIN) — used for the final verify step.
  pin            String? @unique
  // Deterministic HMAC(PIN, PIN_LOOKUP_SECRET). Used as an O(1) index for
  // PIN auth: look up the single candidate user, then bcrypt-verify against
  // `pin`. Avoids a full table scan on every PIN login.
  pinLookup      String? @unique
  name           String
  phone          String  @default("")
  role           String  @default("OPERATOR")
  isActive       Boolean @default(true)
  sessionVersion Int     @default(0)
  timezone       String  @default("Europe/Moscow")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reports         Report[]
  sites           UserSiteAssignment[]
  crews           Crew[]               @relation("CrewOperator")
  crewAssistantOf CrewAssistant[]      @relation("CrewAssistantUser")
  feedbackReads   FeedbackEventRead[]
  documents       UserDocument[]
  briefings       BriefingRecord[]
  placePresets    UserPlacePreset[]
  operatorChecklistTemplatesCreated OperatorChecklistTemplate[] @relation("OperatorChecklistTemplateCreatedBy")
  operatorChecklistExecutionsStarted OperatorChecklistExecution[] @relation("OperatorChecklistExecutionStartedBy")
  operatorChecklistAnswersRecorded OperatorChecklistAnswerRecord[] @relation("OperatorChecklistAnswerRecordedBy")
  operatorShiftEvidenceRecorded OperatorShiftEvidence[] @relation("OperatorShiftEvidenceRecordedBy")

  shiftsCreated            Shift[]              @relation("ShiftCreatedBy")
  shiftsEdited             Shift[]              @relation("ShiftEditedBy")
  shiftsStarted            Shift[]              @relation("ShiftStartedBy")
  shiftsClosed             Shift[]              @relation("ShiftClosedBy")
  shiftsCancelled          Shift[]              @relation("ShiftCancelledBy")
  shiftHandoversSubmitted  ShiftHandover[]      @relation("ShiftHandoverSubmittedBy")
  shiftHandoversAccepted   ShiftHandover[]      @relation("ShiftHandoverAcceptedBy")
  shiftHandoversReworked   ShiftHandover[]      @relation("ShiftHandoverReworkedBy")
  workPermitsAuthored      WorkPermit[]         @relation("WorkPermitAuthoredBy")
  workPermitsEdited        WorkPermit[]         @relation("WorkPermitEditedBy")
  workPermitsRevoked       WorkPermit[]         @relation("WorkPermitRevokedBy")
  workPermitApprovals      WorkPermitApproval[] @relation("WorkPermitApprovedBy")

  @@unique([tenantId, id])
  @@index([email])
  @@index([tenantId])
  @@index([tenantId, role, isActive])
}

// ============================================================
// ДОКУМЕНТЫ РАБОТНИКА — допуск людей к работе
// ------------------------------------------------------------
// Документы техники (EquipmentDocument) в системе были с самого начала,
// документов людей не было вовсе: права на управление установкой, медосмотр,
// удостоверение по охране труда нигде не хранились и по срокам не
// контролировались. Диспетчеру нечего было проверять.
//
// Вид документа — справочник, а не enum в коде: список задаётся
// законодательством и заказчиком, он будет пополняться. Enum потребовал бы
// релиза на каждый новый вид (см. навык module-vs-dictionary).
// ============================================================

model UserDocumentType {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String // «Удостоверение машиниста копровой установки»
  normalizedName     String
  /// Бессрочные документы существуют — для них срок не спрашиваем.
  requiresExpiry     Boolean @default(true)
  /// Подсказка при заведении: на сколько месяцев обычно выдаётся.
  defaultValidMonths Int?
  /// За сколько дней предупреждать об окончании срока. 30 — решение владельца
  /// от 15.08.2026: у документов, в отличие от ТО, продление занимает недели.
  leadTimeDays       Int     @default(30)
  /// Без этого документа оператор к смене не допускается. Отмечает
  /// администратор: какие удостоверения обязательны, решает не программа, а
  /// законодательство и заказчик. По умолчанию false — включение обязательности
  /// останавливает работу, и делать это молча за администратора нельзя.
  requiredForOperator Boolean @default(false)
  isActive           Boolean @default(true)
  notes              String  @default("")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  documents UserDocument[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive])
}

model UserDocument {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  typeId    String
  number    String    @default("")
  issuedAt  DateTime? @db.Timestamptz(3)
  /// null — документ бессрочный. Контроль просрочки такие пропускает.
  expiresAt DateTime? @db.Timestamptz(3)
  /// Скан документа в Media. Связь мягкая (без FK), как у остальных вложений.
  mediaId   String?
  notes     String    @default("")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type UserDocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, typeId])
}

/// Что записано в журнале: ознакомление с инструкцией или проверка знаний.
/// Два значения, заданные кодом, — это перечисление, а не справочник:
/// появление третьего вида означает новый код, который его записывает.
enum BriefingRecordKind {
  INSTRUCTION
  KNOWLEDGE
}

/// Журнал инструктажей: каждое ознакомление с инструкцией и каждая проверка
/// знаний — отдельной строкой, навсегда.
///
/// ПОЧЕМУ ОТДЕЛЬНО ОТ UserDocument. Документ работника отвечает на вопрос «есть
/// ли у человека действующее подтверждение сейчас»: одна строка на вид, она
/// обновляется на месте. Журнал отвечает на другой вопрос — «кто и когда
/// проходил», и ответ на него накапливается. Свести их в одну таблицу нельзя ни
/// в одну сторону: хранить историю в документах значит засыпать карточку
/// работника и список просрочки сотней строк «ознакомлен» за год, а обновлять
/// на месте — стирать историю. Поэтому команда пишет в обе таблицы: состояние
/// туда, факт сюда.
///
/// СНИМОК ФИО И ДОЛЖНОСТИ. Журнал — документ: он показывает, кем человек был в
/// день инструктажа. Переименование учётной записи или перевод на другую
/// должность не должны задним числом переписывать подписанный лист — то же
/// правило и по той же причине, что у WorkPermit.
model BriefingRecord {
  id       String             @id @default(cuid())
  tenantId String
  userId   String
  kind     BriefingRecordKind

  /// Снимок на момент записи — см. примечание к модели.
  userName String
  userRole String

  /// Инструкция, к которой относится запись. Текст инструкций живёт в коде, и
  /// версия — единственное, чем запись привязана к той редакции, которую
  /// человек действительно читал.
  documentCode    String
  documentTitle   String
  documentVersion String

  /// Итог проверки знаний: верных ответов из общего числа. У ознакомления
  /// результата нет — там null.
  correct Int?
  total   Int?

  /// До какой даты действует проверка знаний. Ознакомление бессрочно.
  validUntil DateTime? @db.Timestamptz(3)

  recordedAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  /// Журнал читают периодом и по работнику — этими двумя способами и только ими.
  @@index([tenantId, recordedAt])
  @@index([tenantId, userId, recordedAt])
}

// ============================================================
// EQUIPMENT PARK
// ============================================================

model Equipment {
  id          String  @id @default(cuid())
  name        String
  model       String  @default("")
  qty         Int     @default(1)
  isActive    Boolean @default(true)
  tenantId    String
  description String  @default("")

  // A. Identification --------------------------------------------------
  inventoryNumber    String?
  registrationNumber String? // госномер для самоходных
  kind               EquipmentKind @default(OTHER)
  baseVehicle        String? // "Volvo EC360BLC" — носитель для КБУРГа и т.п.
  serialNumber       String?
  manufactureYear    Int?
  vin                String?

  // B. Technical specs (единый шаблон) --------------------------------
  weightTons              Float?
  weightWithEquipmentTons Float?
  // Логистические габариты в миллиметрах
  heightMm                Int?
  lengthMm                Int?
  widthMm                 Int?
  // Двигатель
  engineBrand             String?
  engineSerialNumber      String?
  enginePower             Int? // кВт
  // Свайные / буровые
  maxPileLength           Float? // м
  maxDrillingDepth        Float? // м
  // Молот
  hammerType              String? // "Junttan HHK-5/7", "PVE 50PR"
  hammerSerialNumber      String?
  hammerEnergyKj          Float? // кДж
  // Атрибуты сборки чек-листа: подбор блоков МОЛОТ и ВРАЩАТЕЛЬ
  hammerKind              HammerKind @default(NONE) // гидро / дизель / нет
  isCombined              Boolean    @default(false) // есть вращатель

  // Устаревшие поля из предыдущей итерации — оставлены чтобы не делать
  // destructive миграцию. UI шаблона их не показывает; удалить отдельной
  // миграцией когда подтвердишь что не нужны.
  heightMeters    Float?
  maxPileDiameter Int?

  // C. Operation -------------------------------------------------------
  purchaseDate           DateTime? @db.Timestamptz(3)
  purchasePrice          Decimal?  @db.Decimal(14, 2)
  engineHoursTotal       Int? // суммарная наработка
  fuelTankLiters         Int? // объём топливного бака, л — для расчёта расхода из остатка %
  nextMaintenanceAtHours Int?
  nextMaintenanceDate    DateTime? @db.Timestamptz(3)
  homeBaseLocation       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  crews                 Crew[]
  reports               Report[]                     @relation("ReportEquipment")
  deviceKeys            DeviceKey[]
  telematicsDevices     TelematicsDevice[]
  telematicsAssignments TelematicsDeviceAssignment[]
  documents             EquipmentDocument[]
  maintenanceRecords    MaintenanceRecord[]
  inspections           Inspection[]
  defects               EquipmentDefect[]
  meterReadings         MeterReading[]
  fuelLogs              FuelLog[]
  maintenancePlans      MaintenancePlan[]
  operatorChecklistExecutions OperatorChecklistExecution[]
  operatorShiftEvidence OperatorShiftEvidence[]

  shifts      Shift[]
  workPermits WorkPermit[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([isActive])
  @@index([kind])
  @@index([inventoryNumber])
}

enum EquipmentKind {
  PILE_DRIVER // забивные копры с молотом
  DRILLING_RIG // буровые установки
  VIBRO_HAMMER // вибропогружатели
  HYBRID // умеющие и забивку, и бурение (Liebherr LRH и т.п.)
  OTHER
}

// Тип молота на установке — управляет подбором блока МОЛОТ чек-листа
enum HammerKind {
  HYDRAULIC // гидравлический
  DIESEL // дизельный
  NONE // молота нет
}

// ============================================================
// EQUIPMENT DOCUMENTS — паспорт, ОТС, страховка, ТО и т.п.
// Файлы хранятся в Media (entityType="equipment"), здесь
// только метаданные документа: тип, срок действия, заметки.
// ============================================================
model EquipmentDocument {
  id          String                @id @default(cuid())
  tenantId    String
  equipmentId String
  type        EquipmentDocumentType
  title       String // user-facing название документа
  issuedAt    DateTime?             @db.Timestamptz(3)
  expiresAt   DateTime?             @db.Timestamptz(3)
  mediaId     String? // привязка к файлу в Media (опц.)
  notes       String                @default("")
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([equipmentId])
  @@index([type])
  @@index([expiresAt])
}

enum EquipmentDocumentType {
  PASSPORT // паспорт установки
  OTS // освидетельствование транспортного средства
  INSURANCE // страховка ОСАГО / КАСКО / спецтехника
  INSPECTION // технический осмотр / диагностика
  CERTIFICATE // сертификат соответствия
  MAINTENANCE_LOG // журнал ТО / акт ТО
  OTHER
}

// ============================================================
// MAINTENANCE — журнал ТО и ремонтов по установке
// Ручной ввод (диспетчер/админ). Без склада запчастей и workflow
// согласования — это MVP сервисного контура. Стоимость опциональна,
// заложена под будущую аналитику затрат.
// ============================================================
model MaintenanceRecord {
  id                   String              @id @default(cuid())
  tenantId             String
  equipmentId          String
  type                 MaintenanceType
  status               MaintenanceStatus   @default(PLANNED)
  title                String
  description          String              @default("")
  scheduledAt          DateTime?           @db.Timestamptz(3) // плановая дата
  completedAt          DateTime?           @db.Timestamptz(3) // факт выполнения
  engineHoursAtService Int? // моточасы на момент работ
  cost                 Decimal?            @db.Decimal(14, 2) // опц., затраты
  performedBy          String? // кто выполнил (свободный текст)
  priority             MaintenancePriority @default(NORMAL) // приоритет наряда
  assigneeId           String? // исполнитель (User.id), без relation — как createdById
  startedAt            DateTime?           @db.Timestamptz(3) // начало работ (для MTTR)
  laborHours           Float? // трудозатраты, ч
  faultCause           String? // стадия 1: диагностика / причина отказа
  workDone             String              @default("") // стадия 2: выполненные работы
  partsUsedText        String              @default("") // израсходованные запчасти текстом ("крючок" под склад)
  cancelReason         String? // почему наряд отменён (обязательна при переводе в CANCELLED)
  closedById           String? // кто проверил/закрыл (User.id)
  acceptedById         String? // кто принял работу (админ, User.id)
  acceptedAt           DateTime?           @db.Timestamptz(3) // когда принято
  createdById          String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  equipment  Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspection Inspection? // заполненный чек-лист для записей ЕО/ТО (1:1)

  @@index([tenantId])
  @@index([equipmentId])
  @@index([status])
  @@index([scheduledAt])
  @@index([assigneeId])
  @@index([priority])
}

enum MaintenanceType {
  // Уровни ТО (с собранным чек-листом):
  EO // ежедневный осмотр и обслуживание
  TO1 // плановое ТО-1
  TO2 // плановое ТО-2
  TO3 // плановое ТО-3
  SEASONAL // сезонное ТО
  // Свободный ввод:
  REPAIR // ремонт
  FAULT // неисправность
  // Deprecated — оставлены ради недеструктивной миграции; новые записи не создаём:
  SCHEDULED // (≈ TO1)
  INSPECTION // (≈ EO)
}

enum MaintenanceStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  DONE
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// ============================================================
// DEFECTS — журнал неисправностей
// Дефект — это НАБЛЮДЕНИЕ («что не так»), которое фиксирует оператор в поле.
// Наряд (MaintenanceRecord) — это РАБОТА («что делаем»), её заводит диспетчер.
// Раньше обе роли играл наряд типа REPAIR/FAULT: замечание нельзя было
// записать, не открыв ремонт, поэтому мелкие наблюдения терялись.
// Простой (ReportDowntime) — это ПОТЕРЯ ВРЕМЕНИ, к дефекту отношения не имеет.
// ============================================================
model EquipmentDefect {
  id          String         @id @default(cuid())
  tenantId    String
  equipmentId String
  severity    DefectSeverity @default(NORMAL)
  status      DefectStatus   @default(OPEN)
  title       String
  description String         @default("") @db.Text
  node        String? // узел: «Гидросистема — распределитель вращения»

  // происхождение
  reportedById String
  reportedAt   DateTime @default(now()) @db.Timestamptz(3)
  inspectionId String? // если замечание найдено на предсменном осмотре
  shiftId      String? // смена, в которую обнаружен
  // Устойчивый ключ источника: «этот пункт чек-листа на этой установке».
  // По нему повторный осмотр узнаёт уже заведённый дефект и не плодит копии —
  // иначе одна незакрытая течь давала бы новую запись каждую смену.
  sourceKey    String?
  /// Наблюдаемые оператором признаки. Критичность вычисляет серверное правило,
  /// оператор её не выбирает.
  observedSigns            Json    @default("[]")
  safeStopApplied          Boolean @default(false)
  classificationRuleId     String?
  classificationRuleVersion String?
  evidenceMediaIds         Json    @default("[]")

  // разбор диспетчером
  triagedById         String?
  triagedAt           DateTime? @db.Timestamptz(3)
  maintenanceRecordId String? // наряд, созданный под устранение

  // закрытие
  resolvedById String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  resolution   String?   @db.Text // что сделали либо почему отклонён

  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, equipmentId, status])
  @@index([tenantId, status, severity])
  @@index([tenantId, reportedAt])
  @@index([tenantId, maintenanceRecordId])
  @@index([equipmentId])
  @@index([tenantId, sourceKey, status])
}

enum DefectSeverity {
  LOW // наблюдение, работе не мешает
  NORMAL // устранить в плановом порядке
  HIGH // устранить как можно скорее
  CRITICAL // эксплуатация запрещена
}

enum DefectStatus {
  OPEN // зарегистрирован, ждёт разбора диспетчером
  IN_WORK // принят в работу: назначен наряд либо уже чинят
  CLOSED // устранён
  REJECTED // не подтвердился либо дубль
}

// ============================================================
// METER READINGS — журнал показаний наработки (моточасы)
// Источник истины наработки — история показаний, а не одно поле.
// Equipment.engineHoursTotal остаётся денормализованным кэшем
// «последнего показания» (обновляется командой на каждое новое).
// Фаза телеметрии пишет сюда с source=TELEMETRY без изменения модели.
// ============================================================
model MeterReading {
  id           String      @id @default(cuid())
  tenantId     String
  equipmentId  String
  recordedAt   DateTime    @db.Timestamptz(3) // когда снято показание
  engineHours  Int // моточасы на момент снятия
  source       MeterSource @default(MANUAL)
  recordedById String? // кто внёс (User.id), без relation — как createdById
  note         String      @default("")
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([equipmentId, recordedAt])
}

enum MeterSource {
  MANUAL
  TELEMETRY
}

// ============================================================
// FUEL LOG — журнал топлива (долив и остаток по указателю)
// Тот же приём, что у MeterReading: источник истины — история записей,
// а не одно поле. Расход НЕ храним отдельным числом — он выводится из
// долива, остатка и объёма бака (Equipment.fuelTankLiters), а моточасы для
// «л/моточас» берём из MeterReading, чтобы не заводить вторую копию факта.
// Фаза телеметрии пишет сюда с source=TELEMETRY без изменения модели: бокс
// на баке становится ещё одним источником и вытесняет ручной ввод.
// ============================================================
model FuelLog {
  id           String      @id @default(cuid())
  tenantId     String
  equipmentId  String
  recordedAt   DateTime    @db.Timestamptz(3) // когда сделана запись
  litersAdded  Int? // сколько залито в бак за эту запись, л (у долива)
  tankPercent  Int? // остаток по указателю на момент записи, % (0–100)
  source       MeterSource @default(MANUAL)
  recordedById String? // кто внёс (User.id), без relation — как createdById
  note         String      @default("")
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([equipmentId, recordedAt])
}

// ============================================================
// MAINTENANCE PLANS — регламенты планового ТО (PM scheduler, P3)
// Правило «через сколько моточасов / дней снова делать ТО». Воркер
// ежедневно считает срок из последнего MeterReading (HOURS) или
// lastDoneAt+intervalDays (CALENDAR) и, попав в окно leadTimeDays,
// создаёт наряд (MaintenanceRecord, status=PLANNED), дедуп по открытым
// нарядам этой установки. Замыкание цикла: закрытие планового наряда
// обновляет lastDoneHours/lastDoneAt у правила.
// ============================================================
model MaintenancePlan {
  id            String          @id @default(cuid())
  tenantId      String
  equipmentId   String
  title         String
  type          MaintenanceType @default(TO1) // тип наряда, который порождает правило
  triggerType   PmTriggerType
  intervalHours Int? // для HOURS
  intervalDays  Int? // для CALENDAR
  leadTimeDays  Int             @default(7) // за сколько дней предупреждать/создавать наряд
  lastDoneHours Int? // моточасы последнего выполнения
  lastDoneAt    DateTime?       @db.Timestamptz(3) // дата последнего выполнения
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([equipmentId])
  @@index([isActive])
}

enum PmTriggerType {
  HOURS
  CALENDAR
}

// ============================================================
// INSPECTIONS — Checklist engine (ЕО/ТО)
// ============================================================

/// Фаза смены, в которой проведён осмотр. Нужна, чтобы сравнить состояние
/// машины на входе и на выходе: без неё два осмотра одной смены неразличимы.
enum InspectionPhase {
  PRE_SHIFT
  POST_SHIFT
}

enum ChecklistLevel {
  EO
  TO1
  TO2
  TO3
  SEASONAL
}

enum AnswerType {
  YES_NO
  STATUS4
  DONE
  MEASURE
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum BlockType {
  BASE // база установки (по марке/модели)
  HAMMER // блок молота (по типу молота)
  ROTARY // блок вращателя (для комбинированных)
}

model ChecklistTemplate {
  id                  String             @id @default(cuid())
  tenantId            String
  name                String
  level               ChecklistLevel
  blockType           BlockType          @default(BASE)
  appliesToModel      String? // для BASE-блоков: марка/модель
  appliesToHammerKind HammerKind? // для HAMMER-блоков: тип молота
  isActive            Boolean            @default(true)
  createdById         String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  sections            ChecklistSection[]
  inspections         Inspection[]

  @@index([tenantId])
  @@index([tenantId, level])
  @@index([tenantId, blockType, level])
}

model ChecklistSection {
  id         String            @id @default(cuid())
  tenantId   String
  templateId String
  title      String
  order      Int
  items      ChecklistItem[]
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([templateId])
}

model ChecklistItem {
  id             String           @id @default(cuid())
  tenantId       String
  sectionId      String
  text           String
  answerType     AnswerType       @default(YES_NO)
  unit           String?
  norm           String?
  provenance     String?
  photoRequired  Boolean          @default(false)
  required       Boolean          @default(true)
  // Замыкание контура «осмотр → дефект». Пункт чек-листа умеет сказать, что
  // отрицательный ответ на него — это не просто минус к баллу, а
  // зафиксированная неисправность. Раньше механик отвечал «нет» на «есть ли
  // течь гидравлики», и не происходило ничего: часть логики допуска жила вне
  // системы, в голове осматривающего.
  createsDefect  Boolean          @default(false)
  // Серьёзность заводимого дефекта. CRITICAL останавливает эксплуатацию
  // системным правилом безопасности (SYSTEM_SAFETY_BLOCKERS).
  defectSeverity String?
  order          Int
  section        ChecklistSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sectionId])
}

model TenantSettings {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  companyName   String   @default("")
  inn           String   @default("")
  timezone      String   @default("Europe/Moscow")
  dateFormat    String   @default("DD.MM.YYYY")
  units         String   @default("metric")
  currency      String   @default("RUB")
  // Notification preferences: { [key]: boolean }.
  notifications Json     @default("{}")
  updatedBy     String   @default("")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ReadinessRuleSet {
  id          String    @id @default(cuid())
  tenantId    String
  status      String
  version     String
  criteria    Json
  blockers    Json
  updatedBy   String?
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@index([tenantId, status])
}

/// Матрица доступов контура готовности: роль → полномочия.
/// Тот же жизненный цикл, что у ReadinessRuleSet (черновик → публикация →
/// архив), потому что это такая же политика организации, а не код.
/// Отсутствие опубликованной строки означает «действуют значения из кода».
model ReadinessAccessMatrix {
  id          String    @id @default(cuid())
  tenantId    String
  status      String
  version     String
  /// { "OPERATOR": ["readiness.read", ...], ... } — только известные роли и
  /// полномочия, лишнее отбрасывается при сохранении.
  grants      Json
  updatedBy   String?
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@index([tenantId, status])
}

// Immutable readiness evidence projection. Workflow relations are added in
// their owning migrations; this additive slice intentionally keeps shiftId
// nullable so it can ship before Shift exists.
model ReadinessScoreSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  equipmentId    String
  shiftId        String?
  ruleSetId      String
  ruleSetVersion String
  triggerType    String
  triggerId      String
  status         String
  // Полный вердикт домена. `status` — его двоичная проекция (READY/BLOCKED),
  // из-за которой «требуется подтверждение» и «запрещено» приходили на экран
  // одинаковыми. Nullable: снимки, записанные до 2026-08-13, вердикта не знают.
  verdict        String?
  score          Int
  blockers       Json
  warnings       Json
  evidence       Json
  facts          Json?
  factsHash      Bytes    @db.ByteA
  calculatedAt   DateTime @default(now()) @db.Timestamptz(3)

  shiftsStarted Shift[] @relation("ShiftStartSnapshot")

  @@unique([tenantId, equipmentId, triggerType, triggerId])
  currentReadiness CurrentReadiness[]

  @@unique([tenantId, id])
  @@index([tenantId, equipmentId, calculatedAt])
  @@index([tenantId, status, calculatedAt])
  @@index([tenantId, shiftId, calculatedAt])
}

// Latest readiness projection. History remains in ReadinessScoreSnapshot;
// this row only advances when a newer authoritative snapshot is observed.
model CurrentReadiness {
  tenantId     String
  equipmentId  String
  snapshotId   String
  status       String
  verdict      String?
  score        Int
  calculatedAt DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  snapshot ReadinessScoreSnapshot @relation(fields: [tenantId, snapshotId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, equipmentId])
  @@index([tenantId, status, calculatedAt])
  @@index([tenantId, snapshotId])
}

// Durable per-tenant cursor for resumable readiness snapshot backfills.
model ReadinessBackfillProgress {
  tenantId        String    @id
  lastEquipmentId String?
  processedCount  Int       @default(0)
  errorCount      Int       @default(0)
  lastError       String?
  status          String    @default("RUNNING")
  startedAt       DateTime  @default(now()) @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)

  @@index([status, updatedAt])
}

enum WorkPermitRisk {
  NORMAL
  ELEVATED
}

enum WorkPermitState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXPIRED
  REVOKED
}

enum WorkPermitApprovalRole {
  DISPATCHER
  ADMIN
}

enum ShiftType {
  DAY
  NIGHT
}

enum ShiftState {
  PLANNED
  PENDING_ACCEPTANCE
  STARTED
  HANDOVER_PENDING
  CLOSED
  CANCELLED
}

enum ShiftHandoverState {
  DRAFT
  SUBMITTED
  REWORK_REQUIRED
  ACCEPTED
}

model Shift {
  id              String          @id @default(cuid())
  tenantId        String
  equipmentId     String
  type            ShiftType
  state           ShiftState      @default(PLANNED)
  productionDate  DateTime        @db.Date
  timezone        String
  plannedStartAt  DateTime?       @db.Timestamptz(3)
  plannedEndAt    DateTime?       @db.Timestamptz(3)
  createdById     String
  lastEditedById  String
  requestedAt     DateTime?       @db.Timestamptz(3)
  requestedById   String?
  startedAt       DateTime?       @db.Timestamptz(3)
  startedById     String?
  declinedAt      DateTime?       @db.Timestamptz(3)
  declinedById    String?
  declineReason   String?
  closedAt        DateTime?       @db.Timestamptz(3)
  closedById      String?
  cancelledAt     DateTime?       @db.Timestamptz(3)
  cancelledById   String?
  closeExceptionReason String? @db.Text
  cancelReason    String?
  /// Смена закрыта планировщиком по окончании производственных суток, потому
  /// что её не сдали. Отличает «закрыто по факту сдачи» от «закрыто временем»:
  /// первое — работа принята, второе — повод спросить, почему не сдали.
  autoClosedAt    DateTime?       @db.Timestamptz(3)
  version         Int             @default(1)
  startSnapshotId String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  handovers       ShiftHandover[]
  permits         WorkPermit[]
  operatorChecklistExecutions OperatorChecklistExecution[]
  operatorShiftEvidence OperatorShiftEvidence[]

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment     Equipment               @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)
  creator       User                    @relation("ShiftCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  editor        User                    @relation("ShiftEditedBy", fields: [tenantId, lastEditedById], references: [tenantId, id], onDelete: Restrict)
  starter       User?                   @relation("ShiftStartedBy", fields: [tenantId, startedById], references: [tenantId, id], onDelete: Restrict)
  closer        User?                   @relation("ShiftClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onDelete: Restrict)
  canceller     User?                   @relation("ShiftCancelledBy", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict)
  startSnapshot ReadinessScoreSnapshot? @relation("ShiftStartSnapshot", fields: [tenantId, startSnapshotId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, equipmentId, productionDate])
  @@index([tenantId, state, updatedAt])
  @@index([tenantId, autoClosedAt])
  @@index([tenantId, startSnapshotId])
}

/// Разрешение диспетчера на пуск заблокированной машины.
///
/// Единственный законный путь из отказа в работу: оператор обойти блокировку
/// не может, а решение должно оставлять след — кто выпустил, почему и на какие
/// именно препятствия. Отсюда обязательная причина и отпечаток препятствий:
/// появилось новое препятствие — разрешение его не покрывает.
///
/// Запись неизменяемая, поэтому у неё нет ни version, ни updatedAt: разрешение
/// не правят, выдают новое. Действует на одну смену — отсюда уникальность.
model ShiftStartWaiver {
  id                 String   @id @default(cuid())
  tenantId           String
  shiftId            String
  /// Снимок готовности, на который смотрел диспетчер, когда решал.
  snapshotId         String
  /// Отсортированный список условий блокировщиков на момент выдачи.
  blockerFingerprint String
  reason             String   @db.Text
  issuedById         String
  issuedAt           DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, shiftId])
  @@index([tenantId, issuedAt])
}

model ShiftHandover {
  id            String             @id @default(cuid())
  tenantId      String
  shiftId       String
  state         ShiftHandoverState @default(DRAFT)
  summary       String             @db.Text
  evidence      Json               @default("{}")
  submittedById String
  submittedAt   DateTime?          @db.Timestamptz(3)
  acceptedById  String?
  acceptedAt    DateTime?          @db.Timestamptz(3)
  reworkedById  String?
  reworkedAt    DateTime?          @db.Timestamptz(3)
  reworkReason  String?
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  shift         Shift              @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  submitter User  @relation("ShiftHandoverSubmittedBy", fields: [tenantId, submittedById], references: [tenantId, id], onDelete: Restrict)
  acceptor  User? @relation("ShiftHandoverAcceptedBy", fields: [tenantId, acceptedById], references: [tenantId, id], onDelete: Restrict)
  reworker  User? @relation("ShiftHandoverReworkedBy", fields: [tenantId, reworkedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, shiftId, state])
  @@index([tenantId, state, updatedAt])
}

enum OperatorEvidenceKind {
  KNOWLEDGE_TEST
  WEATHER_SNAPSHOT
  SITE_CHECK
  STARTUP_READING
  MAINTENANCE_ACTION
  FLUID_READING
  PILE_DRIVING
  LEADER_DRILLING
}

model OperatorChecklistTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  templateKey    String
  version        String
  stage          String
  equipmentModel String
  technology     String?
  definition     Json
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy   User                         @relation("OperatorChecklistTemplateCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  executions  OperatorChecklistExecution[]

  @@unique([tenantId, id])
  @@unique([tenantId, templateKey, version])
  @@index([tenantId, stage, equipmentModel])
}

model OperatorChecklistExecution {
  id               String   @id @default(cuid())
  tenantId         String
  shiftId          String
  equipmentId      String
  templateId       String
  clientCommandId  String
  status            String   @default("IN_PROGRESS")
  templateSnapshot Json
  startedById      String
  startedAt        DateTime @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shift      Shift                        @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  equipment  Equipment                    @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)
  template   OperatorChecklistTemplate    @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  startedBy  User                         @relation("OperatorChecklistExecutionStartedBy", fields: [tenantId, startedById], references: [tenantId, id], onDelete: Restrict)
  answers    OperatorChecklistAnswerRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, clientCommandId])
  @@index([tenantId, shiftId, status, startedAt])
  @@index([tenantId, equipmentId, startedAt])
}

model OperatorChecklistAnswerRecord {
  id              String   @id @default(cuid())
  tenantId        String
  executionId     String
  itemId          String
  clientCommandId String
  result          String
  value           Json?
  note            String?  @db.Text
  mediaIds        Json     @default("[]")
  itemSnapshot    Json
  answeredAt      DateTime @db.Timestamptz(3)
  answeredById    String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
